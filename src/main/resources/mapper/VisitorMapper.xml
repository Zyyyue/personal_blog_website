<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<!--这个写包名加上类名-->
<mapper namespace="com.xixizai.personalblogwebsite.service.Impl.mapper.VisitorMapper">

<!--    批量封禁访客-->
    <update id="batchBlockVisitors">

        update visitors set is_blocked=1
        where id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>

    </update>

<!--    批量解封游客-->
    <update id="batchUnblockVisitors">
        update visitors set  is_blocked=0
        where id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
